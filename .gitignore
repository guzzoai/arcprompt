# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# security - sensitive files
**/*secret*
**/*private*
**/*token*
**/*jwt*
**/*key*
**/*password*
**/*auth*
**/config/secrets*
**/config/private*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp and backup files
*.tmp
*.temp
*.bak
*.backup

# logs with potential sensitive data
*.log
logs/
